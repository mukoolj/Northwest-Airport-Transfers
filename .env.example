# Supabase project (frontend) — safe to expose, protected by Row Level Security.
# Find these in your Supabase project: Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# The following are used by the Supabase Edge Function (supabase/functions/send-booking-emails)
# and must be set as Supabase secrets, NOT in this frontend .env file:
#
#   supabase secrets set RESEND_API_KEY=your-resend-api-key
#   supabase secrets set BUSINESS_EMAIL=northwestairportnsw@gmail.com
#   supabase secrets set RESEND_FROM_EMAIL="Northwest Airport Transfers <bookings@yourdomain.com>"
